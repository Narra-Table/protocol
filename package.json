{
  "name": "@narratable/protocol",
  "version": "2.0.0-dev.1",
  "description": "故桌（NarraTable）接口协议 — 由后端导出契约生成的 TypeScript 类型",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./legacy": {
      "types": "./legacy/proposed_protocol.d.ts"
    },
    "./contract/*": "./contract/*"
  },
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "index.d.ts",
    "generated",
    "contract",
    "legacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narra-Table/protocol.git"
  },
  "license": "AGPL-3.0",
  "keywords": [
    "trpg",
    "narratable",
    "protocol",
    "types"
  ]
}
